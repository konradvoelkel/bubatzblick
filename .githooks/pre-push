#!/usr/bin/bash
# Vor jedem Push dasselbe wie der Job tests in .github/workflows/tests.yml (Rust
# fmt/clippy/Tests, Python-Lint/Tests, check-publishable, about.html, Staedteseiten), dazu cargo
# audit und deny, ~1-2 min. tests/test_hook.py haelt beide Listen gleich.
# Installiert durch `make dev` (git config core.hooksPath .githooks).
# Ueberspringen: git push --no-verify.
set -eo pipefail
# Git ruft den Hook auch, wenn nichts zu senden ist ("Everything up-to-date"),
# und reicht dann keine Zeile auf stdin herein; dasselbe gilt fuer reine
# Loeschungen (lokale SHA aus Nullen). Dann gibt es nichts zu pruefen.
zu_senden=$(awk 'NF >= 4 && $2 !~ /^0+$/')
if [ -z "$zu_senden" ]; then
  echo "pre-push: nichts zu senden -- Pruefkette uebersprungen"
  exit 0
fi
cd "$(git rev-parse --show-toplevel)"
export PATH="$HOME/.cargo/bin:$PATH"
echo "pre-push: Rust"
# Ganzer Workspace, nicht nur das Binary -- `bubatzcore` ist der Geometriekern.
# Kein `| grep` hinter `cargo test`: die Pipe ersetzt den Exit-Code durch den
# von grep, und weil "test result: FAILED" auf das Muster passt, ginge ein
# fehlgeschlagener Lauf als Erfolg durch. `-q` ist schon knapp genug.
(cd rust && cargo fmt --check --all && cargo clippy --workspace --all-targets --locked -q -- -D warnings && cargo test --workspace --locked -q)
if command -v cargo-audit >/dev/null; then (cd rust && cargo audit -q); else echo "pre-push: cargo-audit fehlt (cargo install cargo-audit --locked) -- uebersprungen"; fi
# Dazu cargo-deny wie die CI (Job audit), sofern installiert: es kennt dieselbe
# Advisory-Datenbank, prueft aber auch zurueckgezogene Fassungen (yanked).
if command -v cargo-deny >/dev/null; then cargo deny --log-level error --manifest-path rust/Cargo.toml check advisories; else echo "pre-push: cargo-deny fehlt (cargo install cargo-deny --locked) -- uebersprungen"; fi
echo "pre-push: Python"
# Aus rust/ heraus, damit rustup die Toolchain aus rust-toolchain.toml nimmt (Makefile, core).
(cd rust && uv run -q maturin develop --release -m bubatzcore-py/Cargo.toml >/dev/null)
make -s lint
uv run pytest -n auto -q
make -s check-publishable
make -s about >/dev/null
git diff --exit-code -- viewer/about.html
make -s staedte >/dev/null
git diff --exit-code -- viewer/stadt viewer/sitemap.xml
test -z "$(git status --porcelain -- viewer/stadt)"
