# Vorlage fuer deploy/site.env (nicht versioniert -- `cp site.env.example site.env`).
# Einzige Stelle, an der Domain, Bucket und Deploy-Ziel stehen.

# Domain der Seite und Name der DNS-Zone (meist identisch).
SITE_DOMAIN=example.org
CF_ZONE=example.org

# Host, von dem der Viewer die Kachelarchive laedt (Custom-Domain des Buckets).
TILES_DOMAIN=tiles.${CF_ZONE}

# Objektspeicher mit zonen.pmtiles, fussgaengerzonen.pmtiles, basemap.pmtiles, stand.json.
R2_BUCKET=example-bucket

# rsync-/ssh-Ziel von deploy/bin/deploy_vps.sh. Ein Alias aus ~/.ssh/config,
# kein Benutzer@Adresse: Benutzername, Adresse, Port und Schluessel gehoeren
# in die ssh-Konfiguration des Rechners, der deployt.
#
#   Host site-prod
#     HostName <adresse>
#     User <benutzer>
#     IdentityFile ~/.ssh/<schluessel>
#
VPS_HOST=site-prod

# Zielverzeichnis auf dem Server (Vorgabe, falls nicht gesetzt: /srv/bubatz/www).
#VPS_WWW=/srv/bubatz/www
